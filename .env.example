# Configure these in Vercel Project Settings → Environment Variables.
# Use unique production secrets; never commit actual values.
ADMIN_EMAIL=admin@rrcreativeinteriors.in
ADMIN_PASSWORD=replace-with-a-unique-strong-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Connect a PUBLIC Vercel Blob store to this project for portfolio photos/videos.
# Vercel generates BLOB_READ_WRITE_TOKEN automatically when the store is connected.
BLOB_READ_WRITE_TOKEN=token-from-public-media-store

# Create a separate PRIVATE Vercel Blob store for signed PDFs (4 MB upload cap in admin).
# Add its read/write token to this variable; never expose it with NEXT_PUBLIC_.
RR_PORTFOLIO_MANIFEST_BLOB_TOKEN=token-from-private-documents-store

# Vercel Cron invokes the daily encrypted-backup endpoint. Generate a unique random value (>=32 chars).
CRON_SECRET=generate-a-unique-high-entropy-cron-secret

# PostgreSQL database (Neon free tier is sufficient for initial single-owner pilot).
# Keep the pooled connection string server-side; never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Private Blob store for signed contracts/approvals and private document files.
OPERATIONS_PRIVATE_BLOB_READ_WRITE_TOKEN=token-from-private-operations-store
