# Configure these in Vercel Project Settings → Environment Variables.
# Use unique production secrets; never commit actual values.
ADMIN_EMAIL=admin@rrcreativeinteriors.in
ADMIN_PASSWORD=replace-with-a-unique-strong-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Connect a PUBLIC Vercel Blob store to this project for portfolio photos/videos.
# Vercel generates BLOB_READ_WRITE_TOKEN automatically when the store is connected.
BLOB_READ_WRITE_TOKEN=token-from-public-media-store
